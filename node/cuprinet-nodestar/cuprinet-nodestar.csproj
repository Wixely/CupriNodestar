<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The turnkey reference host: a Nodestar you configure rather than compile. It exists so "run a site on CupriNet"
    needs no C# at all — point it at a directory, set a network, and it serves. The library is the product; this is
    the thin shell around it, and it is deliberately small enough to read in one sitting.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cuprinet-nodestar</AssemblyName>
    <RootNamespace>CupriNet.Nodestar.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriNet.Nodestar\CupriNet.Nodestar.csproj" />

    <!-- The two optional transports. Referenced always, invoked only when configured: each costs disk in the image,
         but a turnkey host whose advertised flags do nothing costs more. That was the state of both until now —
         EnableWebRtc and EnableTor sat in appsettings.json with no implementation to honour them.

         NEITHER carries a UI runtime, which is what keeps this host inside the CupriFace boundary the
         cupriface-boundary CI job enforces. The browser client is supplied as FILES via ClientRoot, not as a
         package reference, precisely so that stays true. -->
    <ProjectReference Include="..\..\src\CupriNet.Nodestar.WebRtc\CupriNet.Nodestar.WebRtc.csproj" />
    <ProjectReference Include="..\..\src\CupriNet.Nodestar.Tor\CupriNet.Nodestar.Tor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
