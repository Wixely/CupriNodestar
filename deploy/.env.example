# Copy to `.env` beside docker-compose.yml. Compose reads it automatically; every value here has a working default,
# so an empty file is a valid file.
#
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------------------------------------------
# The one that usually matters
# ---------------------------------------------------------------------------------------------------------------

# The address your visitors reach this node at — a public IP, or the DNS name in front of it.
#
# A node advertises what its own interfaces report, and in a container that is the bridge — one was observed
# advertising 127.0.0.1 as its only beacon, so every visitor dialled their own loopback. The browser client dials
# the first non-onion beacon and does not fall back to the origin the page came from, so if this is wrong, nothing
# else compensates.
#
# Leave it blank and the node prints at startup what it will advertise instead. That line is worth reading rather
# than skipping: if the address it names is not one your visitors can reach, every Mode 1 visit fails in their
# browser with no trace in the node's log.
NODESTAR_PUBLIC_HOST=

# ---------------------------------------------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------------------------------------------

# Where the HTTP gateway is published on the host. Localhost by default: this is a plain HTTP origin, and binding
# it to 0.0.0.0 without TLS in front serves your site in clear to anything that can route to the host.
NODESTAR_WEB_BIND=127.0.0.1
NODESTAR_WEB_PORT=8080

# The overlay port, published TCP and UDP. Changing it changes both the published port and the advertised one, so
# a port-forward that renumbers still needs the number visitors use, not the one the container binds.
NODESTAR_OVERLAY_PORT=47654

# ---------------------------------------------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------------------------------------------

# Which network this node joins. Nodes on different networks do not see each other, so this is the cheapest way to
# run a private one — but it is not a security boundary, only a namespace.
NODESTAR_NETWORK=cuprinet

# A human-readable label for this node. Cosmetic.
NODESTAR_MONIKER=

# ---------------------------------------------------------------------------------------------------------------
# Building
# ---------------------------------------------------------------------------------------------------------------

# A GitHub PAT with `read:packages`, needed only to BUILD the image — the CupriNet packages are on a private feed.
# Passed as a build secret, so it is not baked into the image or its history. Not needed to run an image you
# already have. Prefer exporting it in your shell over writing it here; a token in a file in the working tree is a
# token waiting to be committed.
GITHUB_PACKAGES_TOKEN=
