<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Nodestar sample. Note what is NOT here: no CupriFace, and no compiled UI of any kind. The site is HTML and CSS
    served over L2, and rendering is the client's job â€” which is precisely the claim this sample exists to make.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Constellation</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The projection is internal — it is sample code, not API — but the redaction boundary it enforces is the
       thing most worth a test, so the test assembly is let in. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Constellation.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriNet.Nodestar\CupriNet.Nodestar.csproj" />
    <!-- The browser on-ramp: transport only, no opinion about what runs in the browser. -->
    <ProjectReference Include="..\..\src\CupriNet.Nodestar.WebRtc\CupriNet.Nodestar.WebRtc.csproj" />
    <!-- The reference client, opted into explicitly. CupriFace is compiled INTO that bundle rather than referenced
         as a package, so even here this project takes no UI-runtime dependency of its own — and dropping this line
         leaves a node that still accepts browsers, just without shipping one a client. -->
    <ProjectReference Include="..\..\src\CupriNet.Nodestar.Client.CupriFace\CupriNet.Nodestar.Client.CupriFace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The site travels with the binary so `dotnet run` works from a clean checkout with no extra steps. -->
    <Content Include="site\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
