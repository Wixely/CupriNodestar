{
  "version": "2.0.0",
  "tasks": [
    {
      // Publishes the browser client and copies it where the CupriFace client package embeds it from. This is the step that
      // makes "run the server" also mean "serve the current client" — without it the host embeds whatever was there
      // last time, which is a confusing way to debug a client change that appears to have no effect.
      "label": "client: publish",
      "type": "shell",
      "command": "dotnet publish clients/web/CupriNet.Nodestar.Client.csproj -c Release",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "client: stage into the CupriFace client package",
      "type": "shell",
      "dependsOn": "client: publish",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "New-Item -ItemType Directory -Force src/CupriNet.Nodestar.Client.CupriFace/client | Out-Null; Copy-Item -Force clients/web/bin/Release/net10.0/browser-wasm/publish/* src/CupriNet.Nodestar.Client.CupriFace/client/"
        ]
      },
      "linux": {
        "command": "mkdir -p src/CupriNet.Nodestar.Client.CupriFace/client && cp -f clients/web/bin/Release/net10.0/browser-wasm/publish/* src/CupriNet.Nodestar.Client.CupriFace/client/"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "build: server",
      "type": "shell",
      "command": "dotnet build samples/Samples.slnx -c Debug",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent" }
    },
    {
      // The full chain a Mode-1 run needs: client published, staged, then the server built against it.
      "label": "build: server + client",
      "dependsOrder": "sequence",
      "dependsOn": ["client: stage into the CupriFace client package", "build: server"],
      "problemMatcher": []
    },

    {
      // Puts beta's link on the clipboard, ready to paste into the client's address bar. This is the one step of
      // the demo that cannot be automated away: a link is minted at runtime and carries live reachability, so there
      // is nothing sensible to hard-code and no way to pre-fill it.
      "label": "demo: copy beta's link",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "$l = (Invoke-RestMethod http://localhost:8081/_nodestar/link.json).link; $l | Set-Clipboard; Write-Host 'beta link copied to clipboard:'; Write-Host $l"
        ]
      },
      "linux": {
        "command": "curl -s http://localhost:8081/_nodestar/link.json | python3 -c \"import sys,json;print(json.load(sys.stdin)['link'])\""
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "demo: copy alpha's link",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "$l = (Invoke-RestMethod http://localhost:8080/_nodestar/link.json).link; $l | Set-Clipboard; Write-Host 'alpha link copied to clipboard:'; Write-Host $l"
        ]
      },
      "linux": {
        "command": "curl -s http://localhost:8080/_nodestar/link.json | python3 -c \"import sys,json;print(json.load(sys.stdin)['link'])\""
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },

    {
      // The product suite: SiteBuilder and the Mode-2 gateway's snapshot path.
      "label": "test: product",
      "type": "shell",
      "command": "dotnet test Nodestar.slnx -c Release",
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // The samples suite — this is where OverlayFeed's redaction tests live. It is a SEPARATE solution, so it is
      // invisible to a Test Explorer that loaded Nodestar.slnx; running it needs its own task.
      "label": "test: samples",
      "type": "shell",
      "command": "dotnet test samples/Samples.slnx -c Release",
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // The default test task (Ctrl+Shift+P → "Run Test Task", or Ctrl+; A). Runs BOTH solutions, because running
      // only one silently reports green while half the repo is untested — and which half depends on which solution
      // the IDE happened to load.
      "label": "test: all",
      "dependsOrder": "sequence",
      "dependsOn": ["test: product", "test: samples"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
