<?xml version="1.0" encoding="utf-8"?>
<!--
  CupriNet.Nodestar.* come from the Wixely GitHub Packages feed rather than nuget.org.

  Credentials are NOT stored here. They come from your own NuGet configuration: add this source once with a personal
  access token that has the "read:packages" scope, using `dotnet nuget add source` with your username and that token
  as the password, and store it in clear text so restore can read it.

  There is no clear element here, so nuget.org and any machine-level sources still apply.
-->
<configuration>
  <packageSources>
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
</configuration>
