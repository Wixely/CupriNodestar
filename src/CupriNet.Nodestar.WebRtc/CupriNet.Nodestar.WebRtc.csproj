<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mode 1 — the browser on-ramp. Two jobs: give the node a WebRTC endpoint browsers can dial, and serve the WASM
    client that dials it.

    This is the package that pulls CupriFace, because it is the package that serves a browser client and CupriFace is
    that client's renderer. The base CupriNet.Nodestar stays free of it, so a Tor or Cloudflare deployment — which
    serves no client at all — carries no UI runtime.
  -->

  <PropertyGroup>
    <RootNamespace>CupriNet.Nodestar.WebRtc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CupriNet.Nodestar\CupriNet.Nodestar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The concrete WebRTC transport: ICE-lite, DTLS 1.3/1.2, SCTP, accept-any-client-cert. -->
    <PackageReference Include="CupriNet.WebRtc" Version="$(CupriNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published client bundle, embedded so the package is self-contained: a host serves the on-ramp without
         needing the wasm toolchain installed or a build step of its own. Populated by clients/web's publish output;
         the glob is empty until that has been published at least once. -->
    <EmbeddedResource Include="client\**\*" LogicalName="client.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
