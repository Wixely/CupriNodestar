# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
out/
artifacts/
publish/

# Blazor / WASM publish + NativeAOT-LLVM intermediates
wwwroot/_framework/
*.wasm
*.bc

# VS / Rider / VS Code
.vs/
.idea/
*.user
*.suo
# VS Code: ignore per-machine state, but SHARE the run/build/test configuration. Those are project deliverables —
# "press Run to see Mode 1" and "Run Test Task covers both solutions" are useless if they live on one laptop.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# NuGet
*.nupkg
*.snupkg
.packages/
project.lock.json

# Test / coverage
[Tt]est[Rr]esult*/
coverage*.json
*.trx

# Node (if the on-ramp client picks up any JS tooling)
node_modules/

# OS
.DS_Store
Thumbs.db

# Local run state / secrets
/data/
appsettings.*.local.json
*.local

# Phase-0 probe publish output (regenerate with: dotnet publish probe/WasmCrypto)
probe/*/bin/
probe/*/obj/

# VS Code launch data directories
/.run/

# Staged client bundle (regenerate with the "client: stage into the CupriFace client package" task)
src/CupriNet.Nodestar.Client.CupriFace/client/*
!src/CupriNet.Nodestar.Client.CupriFace/client/.gitkeep
boundary-packages/

# Compose environment — may hold a packages token. The .example beside it is the tracked one.
deploy/.env
