<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PHASE-2 PROBE — throwaway, not part of the product build.

    The last unknown before the browser client: does CupriFace compile for browser-wasm ALONGSIDE the CupriNet client
    stack, and what does the pair actually cost? CupriFace ships its own WebLlvm host, so the renderer alone is known
    to work; what is not known is the combination, or the bundle size a visitor would download.

    Unlike CupriFace's own web host this needs no JS interop layer: CupriDocument.Render(SKCanvas, …) draws headlessly,
    which is enough to prove the parse → style → layout → paint pipeline survives the toolchain. The Skia and HarfBuzz
    static archives are still required, because that pipeline ends in native code.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <DotNetJsApi>false</DotNetJsApi>
    <UsingBrowserRuntimeWorkload>false</UsingBrowserRuntimeWorkload>
    <WasmEnableLegacyJsInterop>false</WasmEnableLegacyJsInterop>
    <InvariantTimezone>true</InvariantTimezone>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>true</StackTraceSupport>
    <DebugType>none</DebugType>

    <!-- SUPPORT_LONGJMP satisfies libSkiaSharp's __wasm_longjmp, which its image-codec error paths reach for.
         Lifted from CupriFace's own WebLlvm host, where the same link fails without it. -->
    <EmccFlags>$(EmccFlags) -O1 -sSUPPORT_LONGJMP=wasm</EmccFlags>

    <ExecutableExtensionName Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</ExecutableExtensionName>
    <IlcHostRid Condition="'$(IlcHostRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</IlcHostRid>
    <IlcLlvmVersion Condition="'$(IlcLlvmVersion)' == ''">10.0.0-rc.1.26357.1</IlcLlvmVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CupriFace" Version="$(CupriFaceVersion)" />
    <PackageReference Include="CupriNet.Hosting" Version="$(CupriNetVersion)" />
    <PackageReference Include="CupriNet.Alembic.BouncyCastle" Version="$(CupriNetVersion)" />
    <PackageReference Include="CupriNet.Rites" Version="$(CupriNetVersion)" />

    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="$(IlcLlvmVersion)" />
    <PackageReference Include="runtime.$(IlcHostRid).Microsoft.DotNet.ILCompiler.LLVM" Version="$(IlcLlvmVersion)" />

    <!-- Referenced only to put the static archives on disk; the managed/build assets are excluded because this
         project links the natives itself. -->
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.116.1"
                      GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.0.1"
                      GeneratePathProperty="true" ExcludeAssets="all" />

    <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_LLVM_ROOT=$(EmscriptenUpstreamBinPath)" />
    <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(EmscriptenSdkToolsPath)" />
    <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_NODE_JS=$(EmscriptenNodeBinPath)node$(ExecutableExtensionName)" />
    <EmscriptenEnvVars Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single-thread Emscripten 3.1.56 variants, matching the workload toolchain. -->
    <NativeLibrary Include="$(PkgSkiaSharp_NativeAssets_WebAssembly)/buildTransitive/netstandard1.0/libSkiaSharp.a/3.1.56/st/libSkiaSharp.a" />
    <NativeLibrary Include="$(PkgHarfBuzzSharp_NativeAssets_WebAssembly)/buildTransitive/netstandard1.0/libHarfBuzzSharp.a/3.1.56/st/libHarfBuzzSharp.a" />
    <DirectPInvoke Include="libSkiaSharp" />
    <DirectPInvoke Include="libHarfBuzzSharp" />
  </ItemGroup>

</Project>
