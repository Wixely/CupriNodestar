<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    The CupriNet version this product is built against. 0.3.2 is the FLOOR, not a preference: 0.3.2 added a version
    byte to the Oracle frame (a deliberate wire break against 0.3.0), and it is the release that carries the Auspice
    live-feed rite. The v0.3.1 tag published nothing — its CI failed on a test race — so 0.3.1 does not exist on the
    feed. Keep these together so a bump is one edit.
  -->
  <PropertyGroup>
    <CupriNetVersion>0.3.3</CupriNetVersion>
    <CupriWebRtcVersion>0.3.1</CupriWebRtcVersion>
    <CupriFaceVersion>0.2.11</CupriFaceVersion>
  </PropertyGroup>

  <!-- Package metadata (applied when a project opts into packing; see src/Directory.Build.props). -->
  <!--
    PRERELEASE. Nothing here has been consumed by anyone yet, the deploy story is unfinished (see TODO.md), and the
    packaging was restructured recently enough that a consumer-facing shape should not be treated as settled.

    CI overrides Version with `-p:Version=` so every build carries its run number: 0.1.0-alpha.47 rather than a
    hundred artifacts all called 0.1.0-alpha. That matters for the thing these builds exist to support — somebody
    downloading an example, hitting a problem, and sending back a log. Without a distinguishable version, the first
    question is always "which build?", and the answer is usually "I don't know".
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Authors>Wixely</Authors>
    <Company>Wixely</Company>
    <Product>Nodestar</Product>
    <Description>Nodestar — batteries-included hosting for a CupriNet node that also serves an L2 site: a CupriNode, a clearnet HTTP front, and the L2 layer of your choosing.</Description>
    <PackageProjectUrl>https://github.com/Wixely/CupriNodestar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wixely/CupriNodestar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>p2p;networking;decentralized;overlay;hosting;aspnetcore;webrtc</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Only projects that opt in (src/) are packable; tests and samples are not. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
