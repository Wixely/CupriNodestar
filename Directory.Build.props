<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    The CupriNet version this product is built against, and a FLOOR rather than a preference — each bump here is
    something this repository needs rather than routine currency:

      0.3.2  the Auspice live-feed rite, and a version byte on the Oracle frame (a deliberate wire break against
             0.3.0). The v0.3.1 tag published nothing — its CI failed on a test race — so it does not exist.
      0.3.3  the socket-free CupriNet.Shrine package: a static Pilgrimage.OverVesselAsync, which is what lets a
             browser be a Pilgrim without constructing a node that binds sockets.
      0.3.4  CupriNet.Tor finally published, so an onion transport can be referenced at all; plus the Relic rite
             (bulk content over the Shrine path) and an Oracle body guard at the 192 KiB ceiling.
      0.6.1  the .NET WebRTC adapter reports a real MaxMessageBytes too (via CupriWebRTC 0.4.0), so the 0.6.0
             connect-time check is no longer inert on that side. It still cannot catch a browser that negotiated
             low: with no signalling, a browser's offer never reaches the node, so the node's figure means "what we
             will send" rather than "what the pair agreed". The browser end covers that, which is what
             BrowserDataChannel.MaxMessageBytes is for — between the two ends the case is covered and neither covers
             it alone.
      0.6.0  IDataChannel gains MaxMessageBytes and rite frames are size-checked when a transport is handed over
             (RiteTransport.EnsureCarriesRiteFrames), so a vessel that cannot carry a legal frame is refused at
             connect with both numbers named rather than refusing it silently on the wire. A BREAKING change for
             anyone implementing IDataChannel, which this repository does — see BrowserDataChannel. Also makes
             DisposeAsync idempotent across five types, one of which (ShrineSession) our consumer hit without ever
             disposing twice.
      0.3.7  the Conduit's delivery contract, written down after we asked: ordered, never torn, and NOT retried. A
             receiver that lets frames queue past the mux's per-stream limit loses them silently — the send reports
             success and no field in a frame reveals the gap. SiteSession is built around that (it drains rather
             than letting a handler read from the wire), so this is a floor, not currency: the behaviour exists in
             0.3.6 too, and only the contract is new. Also raises the Arcanum conduit's ceiling off the vessel frame
             size, which had made the documented maximum unsendable; the Pilgrimage path this repository uses was
             never affected.
      0.3.6  the Conduit rite reachable from a Pilgrimage — ConduitHost, IConduitHandler, a HostShrine overload and
             ShrineSession.Conduits — which is what SiteBuilder.OnSession is built on. 0.3.5 shipped the seam but a
             sealed conduit was followed by a read that never returned; 0.3.6 latches the seal so the close a site
             author writes against actually arrives. Skipping straight to it is deliberate: on 0.3.5 the natural
             handler ends in a hang rather than an error, which is the worse of the two failures.

    Keep these together so a bump is one edit.
  -->
  <PropertyGroup>
    <CupriNetVersion>0.6.1</CupriNetVersion>
    <!-- 0.4.0 exposes the SCTP association's negotiated message size (CupriWebRTC#1), which is what lets
         CupriNet's adapter answer IDataChannel.MaxMessageBytes with a real number instead of 0. Required by
         CupriNet.WebRtc 0.6.1 rather than merely allowed by it. -->
    <CupriWebRtcVersion>0.4.0</CupriWebRtcVersion>
    <!-- 0.3.0 closes every issue this project filed against the renderer: grid auto-fill/minmax (#51), :root custom
         properties (#53), transform-origin (#54 and its keyword-pair follow-up #63), percentage height on a block
         child (#55), and animating layout properties (#56). Each was re-verified with a headless render probe on
         the bump rather than taken from the changelog. -->
    <CupriFaceVersion>0.3.0</CupriFaceVersion>
  </PropertyGroup>

  <!-- Package metadata (applied when a project opts into packing; see src/Directory.Build.props). -->
  <!--
    PRERELEASE. Nothing here has been consumed by anyone yet, the deploy story is unfinished (see TODO.md), and the
    packaging was restructured recently enough that a consumer-facing shape should not be treated as settled.

    CI overrides Version with `-p:Version=` so every build carries its run number: 0.1.0-alpha.47 rather than a
    hundred artifacts all called 0.1.0-alpha. That matters for the thing these builds exist to support — somebody
    downloading an example, hitting a problem, and sending back a log. Without a distinguishable version, the first
    question is always "which build?", and the answer is usually "I don't know".
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Authors>Wixely</Authors>
    <Company>Wixely</Company>
    <Product>Nodestar</Product>
    <Description>Nodestar — batteries-included hosting for a CupriNet node that also serves an L2 site: a CupriNode, a clearnet HTTP front, and the L2 layer of your choosing.</Description>
    <PackageProjectUrl>https://github.com/Wixely/CupriNodestar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wixely/CupriNodestar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>p2p;networking;decentralized;overlay;hosting;aspnetcore;webrtc</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Only projects that opt in (src/) are packable; tests and samples are not. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
